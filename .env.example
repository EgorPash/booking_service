# ============================================================
# Пример переменных окружения.
# Скопируйте файл в .env и подставьте свои значения.
# Реальные значения в репозиторий НЕ попадают (.env в .gitignore).
# ============================================================

# --- Сервер ---
# Порт, на котором будет слушать бэкенд (для будущего API)
PORT=3000
# Режим окружения: development | production | test
NODE_ENV=development

# --- SQLite ---
# Путь к файлу базы относительно корня проекта.
# Файл базы создаётся автоматически и в git не добавляется.
DATABASE_PATH=server/data/app.sqlite

# --- Часовой пояс студии (IANA) ---
TZ=Europe/Moscow

# --- Записи ---
# Шаг сетки свободных слотов при расчёте доступного времени (минуты).
SLOT_STEP_MINUTES=30
# Сколько минут действует удержание слота на время оформления записи.
HOLD_TTL_MINUTES=10

# --- Безопасность (пригодится на следующих шагах) ---
# Секрет для подписи сессий/токенов — задайте длинное случайное значение.
# ОБЯЗАТЕЛЕН при NODE_ENV=production: без него приложение не запустится.
SESSION_SECRET=change-me
# Стоимость (раунды) хеширования паролей.
PASSWORD_HASH_ROUNDS=12

# --- Только для локальной разработки ---
# Разрешает разрушающие команды (db:reset, seed) при NODE_ENV=production.
# На проде НЕ выставляйте это значение.
# ALLOW_DESTRUCTIVE=1
