# ============================================================
# Пример переменных окружения.
# Скопируйте файл в .env и подставьте свои значения.
# Реальные значения в репозиторий НЕ попадают (.env в .gitignore).
#
# Здесь только настройки окружения. Секретов и паролей в коде нет:
# пароли пользователей хранятся в БД только хешами (scrypt), а сессии —
# как хеши токенов.
#
# Настройки продукта, которые меняет администратор салона (часовой пояс,
# шаг сетки слотов, время жизни удержания, валюта, часы работы), хранятся
# в БД (таблица studios) и правятся через API, а НЕ через .env.
# ============================================================

# --- Сервер ---
# Порт, на котором слушает бэкенд.
PORT=3000
# Режим окружения: development | production | test
NODE_ENV=development

# --- SQLite ---
# Путь к файлу базы относительно корня проекта.
# Файл базы создаётся автоматически и в git не добавляется.
DATABASE_PATH=server/data/app.sqlite

# --- Резервный часовой пояс (IANA) ---
# Основной источник часового пояса — studios.timezone (правит администратор).
# TZ используется только как запасной вариант, если настройки студии ещё нет.
TZ=Europe/Moscow

# --- Безопасность ---
# Срок жизни сессии (токена) в часах. Токен одноразовый и случайный,
# в БД лежит только его хеш; по истечении строку удаляем.
SESSION_TTL_HOURS=168

# Ограничение частоты запросов для входа и регистрации:
# не более N попыток за окно (секунды) с одного IP-адреса.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=300

# Доверять заголовку X-Forwarded-For. По умолчанию выключено: клиент может
# подделать этот заголовок и обойти rate-limit. Включайте (TRUST_PROXY=1)
# только если приложение стоит за своим обратным прокси, который сам
# проставляет X-Forwarded-For (и недоступен напрямую).
# TRUST_PROXY=1

# --- Только для локальной разработки ---
# Разрешает разрушающие команды (db:reset, seed) при NODE_ENV=production.
# На проде НЕ выставляйте это значение.
# ALLOW_DESTRUCTIVE=1
